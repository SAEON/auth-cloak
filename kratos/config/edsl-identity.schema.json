{
  "$id": "https://auth.example.org/schemas/edsl-identity.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EDSL Identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "ory.sh/kratos": {
            "credentials": {"password": {"identifier": true}},
            "recovery": {"via": "email"}
          }
        },
        "name": {"type": "string", "title": "Full name"}
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
