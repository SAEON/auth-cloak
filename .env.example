# ─────────────────────────────────────────────────────────────────────────────
# auth-cloak environment variables
# Copy to .env and fill in real values. Never commit .env.
# Generate strong secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=kratos
POSTGRES_USER=kratos
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ── Kratos hostnames ──────────────────────────────────────────────────────────
# KRATOS_HOSTNAME: public hostname of this auth server (must match SSL cert)
# FDS_HOSTNAME:    hostname of the FDS app (used for CORS allowed origins)
KRATOS_HOSTNAME=CHANGE_ME_hostname
FDS_HOSTNAME=CHANGE_ME_fds_hostname

# ── Kratos secrets (generate with: openssl rand -hex 32) ─────────────────────
# Used to sign session cookies and encrypt sensitive data at rest.
# Changing these after first deploy will invalidate all active sessions.
KRATOS_COOKIE_SECRET=CHANGE_ME_cookie_secret
KRATOS_CIPHER_SECRET=CHANGE_ME_cipher_secret

# ── Admin API bind address ────────────────────────────────────────────────────
# The Kratos Admin API (port 4434) is bound to this IP on the host.
# Set to the server's internal LAN IP so the FDS API (Server 2) can reach it
# over the private network. Never set to 0.0.0.0.
# Pair this with a UFW rule: ufw allow from <fds-lan-ip> to any port 4434
KRATOS_ADMIN_BIND_IP=127.0.0.1

# ── SSL certificate directory ─────────────────────────────────────────────────
# Host path containing fullchain.pem, privkey.pem, chain.pem.
# Typically /etc/letsencrypt/live/<hostname> for Let's Encrypt certs.
SSL_CERT_DIR=/etc/letsencrypt/live/CHANGE_ME_hostname

# ── Backup settings ───────────────────────────────────────────────────────────
BACKUP_DIR=/opt/apps/auth-cloak/backups
BACKUP_RETENTION_DAYS=30
